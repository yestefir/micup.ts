{
  "name": "micup.ts",
  "version": "1.1.0",
  "description": "The TypeScript SDK for Micup bots: Gateway sessions and shards, REST, slash commands, buttons, modals, soundboard and voice",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.tr.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/*.test.js\" && npm run test --workspaces && tsc -p test/tsconfig.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "micup",
    "micup-bot",
    "micup-api",
    "bot",
    "sdk",
    "typescript",
    "gateway",
    "websocket",
    "rest",
    "slash-commands",
    "interactions",
    "components",
    "buttons",
    "modals",
    "sharding",
    "voice",
    "livekit",
    "soundboard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yestefir/micup.ts.git"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "workspaces": [
    "packages/voice"
  ],
  "homepage": "https://github.com/yestefir/micup.ts#readme"
}
