{
  "name": "micup.ts",
  "version": "2.0.0",
  "description": "The TypeScript SDK for Micup bots: Gateway sessions and shards, REST, slash commands, buttons, modals, soundboard and voice",
  "keywords": [
    "micup",
    "micup-bot",
    "micup-api",
    "bot",
    "sdk",
    "typescript",
    "gateway",
    "websocket",
    "rest",
    "slash-commands",
    "interactions",
    "components",
    "buttons",
    "modals",
    "sharding",
    "voice",
    "livekit",
    "soundboard",
    "client"
  ],
  "homepage": "https://github.com/yestefir/micup.ts#readme",
  "bugs": {
    "url": "https://github.com/yestefir/micup.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yestefir/micup.ts.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "easy": [
        "dist/easy/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./easy": {
      "types": "./dist/easy/index.d.ts",
      "default": "./dist/easy/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.tr.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/lib/tsc.js",
    "test": "npm run build && node scripts/run-tests.js test && npm run test --workspaces && node node_modules/typescript/lib/tsc.js -p test/tsconfig.json",
    "test:docs": "node scripts/check-doc-links.js",
    "test:live": "npm run build && node scripts/live-smoke.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/voice"
  ]
}
